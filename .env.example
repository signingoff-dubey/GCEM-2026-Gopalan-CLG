# Several keys per provider are allowed: GROQ_API_KEY_2, GROQ_API_KEY_3, ... (rotated on rate limits)
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
SARVAM_API_KEY=your_sarvam_key_here
# optional
ROOTLENS_JOBS=16
CORS_ORIGINS=*

# ---------- Defect alerts (Settings > Alerts). Leave empty to switch a channel off. ----------
# Recipients (can also be set in Settings > Alerts). Digits with country code, e.g. 919876543210
ALERT_PHONE=
ALERT_WHATSAPP_TO=
ALERT_EMAIL_TO=
# Phone call, option A: Sarvam outbound voice agent (same setup as ARRC)
SARVAM_WORKSPACE_KEY=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
ALERT_CALL_APP_ID=
ALERT_CALL_APP_VERSION=1
ALERT_CALL_AGENT_NUMBER=
ALERT_CALL_CONNECTION_ID=
ALERT_CALL_LANGUAGE=English
# Phone call, option B, and WhatsApp: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALL_FROM=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Email: any SMTP server (Gmail: smtp.gmail.com, port 587, an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
# set to 0 to stop the alert watcher
ROOTLENS_ALERTS=1

# ---------- Blender link (Settings > Integrations): the Blender MCP add-on socket ----------
BLENDER_MCP_HOST=127.0.0.1
BLENDER_MCP_PORT=9876
# headless Blender used to convert .blend uploads
BLENDER_PATH=

# Call outcome: Sarvam posts connected / no_answer / busy / failed here when a call ends (the deployed API's URL)
ALERT_CALL_WEBHOOK_URL=
# random string; Sarvam echoes it back so the webhook can verify the sender
ALERT_WEBHOOK_TOKEN=
# set to 0 to skip AI labelling of uploaded 3D models (geometry and name checks still run)
ROOTLENS_AI_LABEL=1

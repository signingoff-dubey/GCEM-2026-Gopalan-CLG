# Base URL of the RootLens FastAPI backend. Can also be set in Settings > API.
VITE_API_URL=http://127.0.0.1:8000

# Deployed build (Vercel, .env.production): read activity from Firestore and call the API Cloud Function.
VITE_FIREBASE=1
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
